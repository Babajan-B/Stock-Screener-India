# ----- OAuth: LinkedIn -----
# Register a LinkedIn developer app at https://www.linkedin.com/developers/apps
# Redirect URI to configure: {OAUTH_REDIRECT_BASE_URL}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ----- OAuth: Facebook -----
# Register at https://developers.facebook.com
# Redirect URI: {OAUTH_REDIRECT_BASE_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ----- OAuth base URL -----
# Must match the redirect URI registered with each provider.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# ----- Upstash Redis (KV storage) -----
# Free tier: https://upstash.com (10k commands/day)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Token encryption (AES-256-GCM) -----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ----- Playwright service (Instagram publishing) -----
PLAYWRIGHT_SERVICE_URL=http://localhost:4000
PLAYWRIGHT_SERVICE_TOKEN=

# ----- Cron authentication -----
# Header sent by Vercel Cron: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
